# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- Proxmox VE exporter ---
# Create a read-only API token in Proxmox first:
#   Datacenter > Permissions > Users: add  monitoring@pve
#   Datacenter > Permissions > API Tokens: add token for monitoring@pve (uncheck "Privilege Separation")
#   Datacenter > Permissions: add permission  Path "/"  User/Token monitoring@pve!grafana  Role PVEAuditor
PVE_USER=monitoring@pve
PVE_TOKEN_NAME=grafana
PVE_TOKEN_VALUE=replace-with-token-secret

# --- PostgreSQL exporter ---
# Create a read-only monitoring role in the core-stack Postgres first:
#   CREATE ROLE monitoring WITH LOGIN PASSWORD 'strong-password';
#   GRANT pg_monitor TO monitoring;
POSTGRES_EXPORTER_DSN=postgresql://monitoring:strong-password@postgres:5432/postgres?sslmode=disable

# --- Alerting to Discord ---------------------------------------------------
# Discord webhook for #alerts: Server Settings -> Integrations -> Webhooks ->
# New Webhook -> pick #alerts -> Copy Webhook URL.
# Write-only and bot-free by design, so alerts still arrive when the assistant
# bot (or the whole ai stack) is down.
#
# REQUIRED. This is the only path Grafana alerts take — ntfy used to be the
# second one and was removed — so the monitoring stack refuses to start when
# this is empty rather than come up silently unable to page you.
DISCORD_ALERT_WEBHOOK=

# --- Dead man's switch -----------------------------------------------------
# Healthchecks.io ping URL used by scripts/heartbeat.sh. The box pings OUT on a
# cron; if the pings stop, Healthchecks alerts Discord. This is the only thing
# that catches the whole machine being down — everything else runs on it.
# Create a check at https://healthchecks.io (period 5m, grace 15m) and paste
# its ping URL here.
HEALTHCHECKS_PING_URL=
