# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Base domain, same value as docker/proxy/.env. Grafana needs it to know its own
# external address (stats.<domain>): every link it sends OUT is built from this
# — the "Open in Grafana →" button on a Discord alert, silence links, dashboard
# links. Get it wrong and the alerts still arrive, but nothing in them is
# clickable from a phone, which is the one place they are read.
HOMELAB_DOMAIN=home.example.com

# --- Proxmox VE exporter ---
# Create a read-only API token in Proxmox first:
#   Datacenter > Permissions > Users: add  monitoring@pve
#   Datacenter > Permissions > API Tokens: add token for monitoring@pve (uncheck "Privilege Separation")
#   Datacenter > Permissions: add permission  Path "/"  User/Token monitoring@pve!grafana  Role PVEAuditor
PVE_USER=monitoring@pve
PVE_TOKEN_NAME=grafana
PVE_TOKEN_VALUE=replace-with-token-secret

# --- PostgreSQL exporter ---
# Create a read-only monitoring role in the core-stack Postgres first:
#   CREATE ROLE monitoring WITH LOGIN PASSWORD 'strong-password';
#   GRANT pg_monitor TO monitoring;
POSTGRES_EXPORTER_DSN=postgresql://monitoring:strong-password@postgres:5432/postgres?sslmode=disable

# --- Alerting to Discord ---------------------------------------------------
# Discord webhook for #alerts: Server Settings -> Integrations -> Webhooks ->
# New Webhook -> pick #alerts -> Copy Webhook URL.
# Write-only and bot-free by design, so alerts still arrive when the assistant
# bot (or the whole ai stack) is down.
#
# REQUIRED. This is the only path Grafana alerts take — ntfy used to be the
# second one and was removed — so the monitoring stack refuses to start when
# this is empty rather than come up silently unable to page you.
DISCORD_ALERT_WEBHOOK=

# --- Dead man's switch -----------------------------------------------------
# Each of the three below must be a real ping URL. Leaving a placeholder in
# place does not half-configure a switch, it disables one while looking
# configured — so the scripts treat a value that is not a plausible ping URL
# exactly as they treat an empty one: they say so, and they alert (see
# scripts/healthchecks.sh, which exists because of the one that was missed).
# Healthchecks.io ping URL used by scripts/heartbeat.sh. The box pings OUT on a
# cron; if the pings stop, Healthchecks alerts Discord. This is the only thing
# that catches the whole machine being down — everything else runs on it.
# Create a check at https://healthchecks.io (period 5m, grace 15m) and paste
# its ping URL here.
HEALTHCHECKS_PING_URL=

# A second check, for scripts/repo-sync.sh — the nightly pull. That script only
# speaks when there is something to say, so a cron entry that was never
# installed reads as a run of quiet, healthy days; it read that way for three
# weeks while a merged change sat undeployed. The switch above cannot catch it,
# because the box is perfectly alive the whole time.
# Create a second check (period 1d, grace 6h) and paste its ping URL here.
HEALTHCHECKS_REPO_SYNC_URL=

# A third, for scripts/pg-backup.sh — the nightly pg_dumpall. This one had no
# dead man's switch at all until 2026-09-19, which AGENTS.md has forbidden in
# writing the whole time ("anything scheduled needs a dead man's switch,
# including the scheduler"). It is also the lab's ONLY protection against an
# accidental DROP, since there are still no image or offsite backups — so a
# quietly uninstalled cron entry here is the most expensive silence available.
# Create a third check (period 1d, grace 6h) and paste its ping URL here.
HEALTHCHECKS_PG_BACKUP_URL=
