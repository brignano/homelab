          "instant": true,
          "range": false,
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Bind-mounted configs the containers are not actually reading",
      "type": "table",
      "description": "Docker resolves a single-file bind mount to an inode at container create time, and git replaces files rather than editing them. So a pull leaves the container reading an unlinked copy \u2014 indefinitely, while `git pull` says 'Already up to date' and `/-/reload` returns 200. STALE here is fixed by a recreate, never by a restart:\n\n`docker compose -f docker/<stack>/docker-compose.yml up -d --force-recreate <service>`",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "includeByName": {},
            "indexByName": {},
            "renameByName": {
              "Value": "State",
              "container": "Container",
              "path": "File"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "desc": true,
                "field": "State"
              }
            ]
          }
        }
      ]
    },
