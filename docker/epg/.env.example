# The M3U playlists Jellyfin's Live TV tuners use, whitespace- or comma-
# separated. The guide is built for the channels in these and nothing else, so
# keep this in step with Dashboard → Live TV → Tuner Devices.
# Required: the stack refuses to start without it, and this file existing is
# what tells heartbeat.sh the stack is set up (SETUP_GATED_STACKS).
EPG_PLAYLISTS=https://iptv-org.github.io/iptv/countries/us.m3u

# IANA timezone; the grab schedule below is in this zone.
TZ=America/New_York

# Optional overrides (defaults shown).
# EPG_CRON_SCHEDULE=0 1 * * *
# EPG_DAYS=3
# EPG_MAX_CONNECTIONS=2
# Channels per grab process; lower it if a batch runs out of memory.
# EPG_BATCH=50
# Dead guide sources to leave out, as <site> or <site>/<site_id prefix>.
# Setting this replaces the default, so keep i.mjh.nz/Flash/ in the list.
# EPG_SKIP=i.mjh.nz/Flash/
# Jellyfin's tuner reads http://epg:3000/playlist.m3u: these playlists with
# only the channels whose streams answered. Hosts to leave out without
# checking, e.g. jmp2.uk; and "true" to also drop channels with no guide.
# EPG_STREAM_SKIP=
# EPG_REQUIRE_GUIDE=false
