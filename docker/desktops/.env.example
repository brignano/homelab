# Timezone for the desktop containers
TZ=America/New_York

# Login for the webtop UI (don't leave a root-capable desktop open on the tailnet)
DESKTOP_USER=admin
DESKTOP_PASSWORD=changeme

# Kali's VPN (kali-vpn). A NEW Proton WireGuard config, separate from the one in
# docker/downloads/.env: Proton → Downloads → WireGuard configuration → create,
# copy the PrivateKey line. Port forwarding off. Never commit the real value.
KALI_WIREGUARD_PRIVATE_KEY=
# Optional: which country Kali exits from (default United States)
# KALI_VPN_SERVER_COUNTRIES=United States
