# --- Claude API ---------------------------------------------------------------
# A key from the `homelab` WORKSPACE in the Claude Console (not the default
# workspace), so this lane has its own monthly spend limit and alert, summed
# under the org cap alongside brignano-io's. Give the key a 1-year expiry and
# put a renewal reminder on the calendar.
#
# THIS REPO IS PUBLIC. The real key goes only in docker/concierge/.env on the
# box, which .gitignore excludes. Never paste it anywhere else.
ANTHROPIC_API_KEY=sk-ant-changeme

# --- Bot <-> concierge ----------------------------------------------------------
# Shared secret; the SAME value goes in docker/assistant/.env. Generate with:
#   openssl rand -hex 32
CONCIERGE_TOKEN=changeme-openssl-rand-hex-32

# --- Model and per-request ceilings -------------------------------------------
CONCIERGE_MODEL=claude-opus-5-5
CONCIERGE_MAX_TURNS=12
CONCIERGE_MAX_BUDGET_USD=0.50
# The morning brief's own ceilings (the bot's BRIEF_ENABLED turns it on).
CONCIERGE_BRIEF_MAX_TURNS=8
CONCIERGE_BRIEF_MAX_BUDGET_USD=0.20
CONCIERGE_TIMEOUT_S=300

# --- Google (optional; blank = no calendar or mail tools) ---------------------
# The same Desktop-app OAuth client as docker/assistant/.env is fine, but this
# lane signs in separately: it gets calendar.events, gmail.readonly and
# gmail.compose (drafts; nothing here ever sends — see app/google.py).
# Fill in ID and secret, leave the token blank, then run:
#   docker compose -f docker/concierge/docker-compose.yml run --rm concierge --google-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_IDS=primary

# --- Home Assistant (optional; blank = no home tool) --------------------------
# Long-lived token for a dedicated non-admin `concierge` HA user — NOT the
# digest's token. See README.md -> "Home Assistant".
HA_URL=http://host.docker.internal:8123
HA_TOKEN=
# Scenes run_scene may propose, comma-separated scene.* IDs. Blank = no
# run_scene tool. Read each scene first: this list is the only ceiling for
# HA writes (README.md -> "Home Assistant").
HA_SCENES=
# The weather entity weather_forecast reads (a weather.* ID). Needs HA_TOKEN.
# Set it blank to turn the forecast off.
HA_WEATHER_ENTITY=weather.forecast_home
# Calendars home_calendar_events reads, comma-separated calendar.* IDs: the
# Apple calendar through HA's CalDAV integration, so the morning brief sees it
# without a public iCloud link. Same IDs as HA_CALENDARS in
# docker/assistant/.env. Needs HA_TOKEN. Blank = off.
HA_CALENDARS=

# --- Prometheus (homelab_status) ---------------------------------------------
# Through the port Prometheus publishes on the host. Set it blank to turn the
# tool off.
PROMETHEUS_URL=http://host.docker.internal:9090

# --- Radarr / Sonarr (optional; blank = no movie or show tools) ----------------
# API key from each app: Settings -> General -> API Key. Each is independent:
# set only RADARR_API_KEY and you get movies but not shows. See README.md ->
# "Movies and shows".
RADARR_API_KEY=
SONARR_API_KEY=
# The quality profile every approved add uses. Must exist, by this exact name,
# in both apps (Settings -> Profiles). --selftest checks it.
MEDIA_QUALITY_PROFILE=HD-1080p
# Root folders as Radarr/Sonarr see them. Blank = /data/library/movies and
# /data/library/shows, the downloads stack's. Change only if you changed those.
RADARR_ROOT=
SONARR_ROOT=

TZ=America/New_York
