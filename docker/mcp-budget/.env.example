# Budget login. The server password you set on first open of
# https://budget.home.brignano.io (the same value Homepage's Actual widget needs).
ACTUAL_PASSWORD=changeme-actual-server-password
# Settings -> Show advanced settings -> Sync ID, in the app.
ACTUAL_BUDGET_SYNC_ID=changeme-sync-id
# The budget file's end-to-end encryption password. Leave blank only if you
# never turned encryption on.
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
# Bearer token every MCP client sends: openssl rand -hex 32
MCP_BUDGET_TOKEN=changeme-run-openssl-rand-hex-32
