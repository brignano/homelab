# The Proton VPN WireGuard private key: Proton → Downloads → WireGuard
# configuration, platform GNU/Linux, NAT-PMP (Port Forwarding) ON. Only the part
# after "PrivateKey = ". Kept in Google Password Manager as hl-vpn.m5.
# Required: gluetun refuses to start without it.
WIREGUARD_PRIVATE_KEY=

# Where to look for a server. gluetun picks one that forwards a port.
VPN_SERVER_COUNTRIES=United States

# The user the *arr apps and qBittorrent write files as. Must own
# /media/jellyfin/downloads and the movies/shows folders (README, step 2).
PUID=1000
PGID=1000

# IANA timezone, for logs and schedules.
TZ=America/New_York
