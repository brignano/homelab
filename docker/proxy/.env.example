# Bearer token the mcp.home site requires before proxying to the MCP server.
# This is the app-layer guard in front of mcp-grafana (Tailscale is the network
# boundary). The same value goes in each dev machine's Claude Code MCP config.
# Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=changeme-run-openssl-rand-hex-32

# --- Real domain + TLS -----------------------------------------------------
# Base domain the service names hang off. Nesting them under a subdomain (e.g.
# home.example.com) keeps homelab names out of your apex namespace and lets one
# wildcard DNS record cover every service, now and in future.
HOMELAB_DOMAIN=home.example.com

# Cloudflare API token used ONLY to solve the ACME DNS-01 challenge.
# Create at https://dash.cloudflare.com/profile/api-tokens -> Create Token ->
# Custom token, with a single permission:
#
#     Zone | DNS | Edit        (Zone Resources: Include -> your zone)
#
# Do NOT use a Global API Key — that would grant account-wide access for a job
# that only needs to write one TXT record.
CLOUDFLARE_API_TOKEN=changeme-cloudflare-zone-dns-edit-token
