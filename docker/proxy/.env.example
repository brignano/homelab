# Bearer token the mcp.home site requires before proxying to the MCP server.
# This is the app-layer guard in front of mcp-grafana (Tailscale is the network
# boundary). The same value goes in each dev machine's Claude Code MCP config.
# Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=changeme-run-openssl-rand-hex-32

# --- Real domain + TLS -----------------------------------------------------
# Base domain the service names hang off. Nesting them under a subdomain (e.g.
# home.example.com) keeps homelab names out of your apex namespace and lets one
# wildcard DNS record cover every service, now and in future.
HOMELAB_DOMAIN=home.example.com

# Cloudflare API token used ONLY to solve the ACME DNS-01 challenge.
# Create at https://dash.cloudflare.com/profile/api-tokens -> Create Token ->
# Custom token, with a single permission:
#
#     Zone | DNS | Edit        (Zone Resources: Include -> your zone)
#
# Do NOT use a Global API Key — that would grant account-wide access for a job
# that only needs to write one TXT record.
CLOUDFLARE_API_TOKEN=changeme-cloudflare-zone-dns-edit-token

# --- Work and Ideas pages (docker/work/, docker/ideas/) --------------------
# One fine-grained GitHub token, READ-ONLY, shared by work.home's
# /api/graphql route and ideas.home's /api/ledger.json route. Caddy adds it to
# requests to api.github.com so the browser never holds it.
# Create at https://github.com/settings/personal-access-tokens/new:
#   Resource owner: your account. Repository access: Only select repositories,
#   picking the repos in ai-tools fleet/board.yml `repos:` (ai-tools included)
#   plus the ledger's repo. Never life or people.
#   Permissions (all READ-ONLY): Contents, Issues, Pull requests, Commit
#   statuses, Metadata (added automatically).
# Shared means Work's route can read the ledger's repo too (LAN + tailnet
# only). The older per-page names, WORK_GITHUB_TOKEN and IDEAS_GITHUB_TOKEN,
# still work if READ_GITHUB_TOKEN is unset.
# Optional: unset, each page says which variable to set.
READ_GITHUB_TOKEN=

# The Ideas page's ledger: the repo (owner/name) and the JSON file's path in it.
IDEAS_LEDGER_REPO=
IDEAS_LEDGER_PATH=ledger.json
