# Memorable names for homelab services, on a real domain with real certificates.
#
# The sites below are NOT published. DNS for *.{$HOMELAB_DOMAIN} resolves to
# 10.0.0.201, a private address — anyone can look the name up, but only a device
# on the LAN or the Tailscale tailnet can reach it. Nothing is port-forwarded and
# no tunnel is deployed.
#
# Certificates come from Let's Encrypt via the ACME DNS-01 challenge: Caddy
# proves ownership by writing a TXT record to the Cloudflare zone, never by
# receiving a connection. That is what makes real HTTPS possible on a host the
# internet cannot reach.
#
# To add a service: add a site block here, then `docker compose restart caddy`.
# No DNS change is needed — a single wildcard record already covers every name.
{
	# Solve DNS-01 with the Cloudflare API. The token needs exactly one
	# permission: Zone → DNS → Edit, scoped to this zone. See docker/proxy/.env.
	acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}

	# HTTP/1.1 and HTTP/2 only. Caddy advertises h3 via `alt-svc` by default,
	# but compose publishes 443/tcp only, so UDP 443 never reaches it. A phone
	# that has cached the advert tries QUIC first and waits for it to time out
	# on later visits, which looked like Cleanuparr going dark for ~20s after
	# a good first load (2026-11-02). Nothing here needs h3.
	servers {
		protocols h1 h2
	}
}

# ── Services ────────────────────────────────────────────────────────────────

# The landing page. Deliberately the bare {$HOMELAB_DOMAIN} rather than a
# subdomain of it: every service name hangs off this one, so it is the only URL
# worth memorising and the rest are discoverable from it.
#
# NOTE — this needs its own DNS record. The `*.home` wildcard covers
# stats.home.<zone> and friends, but a DNS wildcard substitutes for the `*` and
# never matches the parent name, so home.<zone> resolves nowhere without an
# explicit A record alongside it.
{$HOMELAB_DOMAIN} {
	# Safari's address bar, its suggestion list and its Favorites tiles probe
	# these ROOT paths directly rather than parsing the page, so they never see
	# the icon Homepage declares in its markup — they found its stock logo, or
	# nothing, and fell back to a globe. The dashboard's own files live under
	# /icons (docker/dashboard/icons, mounted into the container), so the probe
	# is pointed at them here rather than by shadowing the image's /app/public.
	# A query string a browser appends survives the rewrite and goes on working
	# as its cache key.
	rewrite /favicon.ico /icons/favicon.ico
	rewrite /apple-touch-icon.png /icons/apple-touch-icon.png
	rewrite /apple-touch-icon-precomposed.png /icons/apple-touch-icon.png

	# And the surface that reads no markup at all: an INSTALLED app. Chrome
	# draws the window titlebar, the taskbar entry and the install dialog from
	# the web app MANIFEST's icons — `rel="icon"` is not consulted, so none of
	# the work above reaches it. Homepage hard-codes
	# `<link rel="manifest" href="/site.webmanifest?v=4">` in its _document and
	# ships a manifest listing its own logo, baked into the image where no
	# config setting reaches it.
	#
	# Rewriting the root path is how that gets overridden without shadowing
	# /app/public with a single-file bind mount. Same technique as the probes
	# above, and for once the `?v=4` Homepage appends is useful: the manifest
	# changing identity is exactly when a cache bust is wanted.
	rewrite /site.webmanifest /icons/site.webmanifest

	# Explicit, rather than trusting the mime table inside whatever Next.js
	# build the image happens to carry. Chrome will parse a manifest served as
	# application/json, but it logs the wrong type as an error in the install
	# path, and an install error is the thing this block exists to fix.
	#
	# Both paths, deliberately. Caddy sorts directives into its own order rather
	# than running them top to bottom, so whether this matcher sees the request
	# before or after the rewrite above is not decided here. Naming both spellings
	# is one line and does not depend on knowing which.
	@manifest path /site.webmanifest /icons/site.webmanifest
	header @manifest Content-Type "application/manifest+json"

	reverse_proxy dashboard:3000
}

# Grafana — dashboards & metrics
stats.{$HOMELAB_DOMAIN} {
	reverse_proxy grafana:3000
}

# Jellyfin — media server (docker/jellyfin/, listens on 8096). Jellyfin joins
# the proxy network rather than Caddy joining a jellyfin one, so this stack
# never depends on Jellyfin being up (see docker/jellyfin/docker-compose.yml).
# LAN + tailnet only: never the Cloudflare tunnel (AGENTS.md, Networking rules).
jellyfin.{$HOMELAB_DOMAIN} {
	reverse_proxy jellyfin:8096
}

# Downloads (docker/downloads/). Like Jellyfin, these join the proxy network, so
# this stack never depends on them being up. qBittorrent has no network of its
# own: it lives inside gluetun's (the VPN), so it is reached as gluetun:8080.
# LAN + tailnet only, never the tunnel. Each app has its own login.
torrent.{$HOMELAB_DOMAIN} {
	reverse_proxy gluetun:8080
}

sonarr.{$HOMELAB_DOMAIN} {
	reverse_proxy sonarr:8989
}

radarr.{$HOMELAB_DOMAIN} {
	reverse_proxy radarr:7878
}

prowlarr.{$HOMELAB_DOMAIN} {
	reverse_proxy prowlarr:9696
}

cleanuparr.{$HOMELAB_DOMAIN} {
	reverse_proxy cleanuparr:11011
}

# Climb clip review page (docker/clipreview/). Joins the proxy network like
# Jellyfin. Family videos: LAN + tailnet only, never the tunnel.
review.{$HOMELAB_DOMAIN} {
	reverse_proxy clipreview:8000
}

# Actual Budget (docker/budget/). Joins the proxy network. Financial data: LAN +
# tailnet only, never the tunnel, and no bank sync is configured.
budget.{$HOMELAB_DOMAIN} {
	# The design-system theme for Actual (docker/budget/theme/). Actual's custom
	# theme box takes one pasted line, `@import url("/_design/actual.css");`, and
	# this serves what it imports, so a repo change reaches the app on the next
	# pull with nothing to re-paste. Tokens and font are the dashboard's own
	# vendored copies (one source), mounted read-only in docker-compose.yml.
	handle /_design/actual.css {
		root * /srv/budget-theme
		rewrite * /actual.css
		file_server
	}
	handle /_design/tokens.css {
		root * /srv/design
		rewrite * /design-tokens.css
		file_server
	}
	handle_path /_design/fonts/* {
		root * /srv/design/fonts
		file_server
	}
	handle {
		# On a phone, every dashboard card on Actual's Reports page is one big
		# button, so a tap meant for scrolling opens the full report. Below
		# Actual's phone breakpoint (730px) this makes the cards look-only:
		# taps pass through to the page, so it still scrolls. Desktop and
		# tablet-width windows are unchanged. Actual's own custom-CSS box only
		# takes `:root` variables, so the rule is added to its page here.
		#
		# Actual's service worker serves its cached copy of the page, so the
		# sw.js rewrite below changes that page's revision in the worker's
		# precache list. The browser sees a new worker, re-fetches the page
		# (through this rewrite) and Actual offers its usual "update" prompt.
		# Bump the `phone1-` prefix whenever the style rule changes.
		# `replace` cannot edit compressed bodies, hence Accept-Encoding.
		# Actual's ETags describe its own bytes, not the rewritten ones, so a
		# browser revalidating with them gets a 304 and keeps the old copy:
		# conditional requests are stripped and the ETags dropped.
		reverse_proxy budget:5006 {
			header_up Accept-Encoding identity
			header_up -If-None-Match
			header_up -If-Modified-Since
			header_down -ETag
			header_down -Last-Modified
		}
		replace {
			match {
				header Content-Type text/html*
			}
			</head> `<style>@media (max-width: 729px) { [data-testid="reports-overview"] button { pointer-events: none; } }</style></head>`
		}
		replace /sw.js {
			"url:\"index.html\",revision:\"" "url:\"index.html\",revision:\"phone1-"
		}
	}
}

# Open WebUI — AI chat (container listens on 8080)
chat.{$HOMELAB_DOMAIN} {
	reverse_proxy open-webui:8080
}

# Portainer — Docker management
apps.{$HOMELAB_DOMAIN} {
	reverse_proxy portainer:9000
}

# AdGuard Home — DNS admin & ad blocking
dns.{$HOMELAB_DOMAIN} {
	reverse_proxy adguard:80
}

# Home Assistant — the home hub (docs/design/tsd-personal-assistant.md, phase 2).
# LAN + tailnet only, like every admin UI here: never route this through the
# Cloudflare Tunnel. HA runs on host networking, so it is reached through the
# host (extra_hosts in ../proxy/docker-compose.yml), not by container name.
# HA must trust Caddy's X-Forwarded-For (Settings > System > Network; see
# docker/homeassistant/README.md), or this site answers 400. WebSockets, which
# the HA frontend lives on, need nothing extra: reverse_proxy upgrades them by
# default.
#
# `http://ha.caddy` is the same site under a second address, for
# blackbox-exporter alone (job `blackbox-ha-caddy` in prometheus.yml). The probe
# has to come through this block to prove the route works, but committed config
# carries no domain, and neither prometheus.yml nor blackbox.yml can read one
# from the environment. So blackbox sends `Host: ha.caddy` to the caddy
# container, and lands here. It shares one address list on purpose: a separate
# block would be a second copy of the route, and the probe would test the copy.
# scripts/check-probes.sh fails CI if they are split. Plain HTTP and no new
# exposure: anyone who can send this Host header can already reach :8123.
ha.{$HOMELAB_DOMAIN}, http://ha.caddy {
	reverse_proxy host.docker.internal:8123
}

# MCP servers for Claude Code: Grafana (read-only metrics/logs/alerts) at
# /mcp and the calendar server at /calendar/mcp.
# Tailscale is the network boundary; this bearer check is the app-layer guard
# (mcp-grafana has no built-in endpoint auth). The Viewer-scoped Grafana service
# account behind it is the hard read-only ceiling. Token comes from
# MCP_BEARER_TOKEN in docker/proxy/.env. If unset, the matcher rejects everything
# (fail-closed) and only this site is affected.
mcp.{$HOMELAB_DOMAIN} {
	@noauth not header Authorization "Bearer {env.MCP_BEARER_TOKEN}"
	@calendar path /calendar/*

	# `route` keeps these in the order written. Caddy sorts bare directives by
	# its own table, which puts `handle` BEFORE `respond`, so splitting the paths
	# with handle blocks would route around the token check entirely.
	route {
		respond @noauth "Unauthorized" 401

		# Calendar MCP server (docker/mcp-calendar): read-only iCloud calendars
		# via Home Assistant, at /calendar/mcp. Its Host allowlist is
		# mcp-calendar:8000, for the same reason as mcp-grafana's below.
		reverse_proxy @calendar mcp-calendar:8000 {
			flush_interval -1
			header_up Host {upstream_hostport}
		}

		# flush_interval -1 disables buffering so MCP streamable-HTTP / SSE events
		# reach the client immediately instead of being held by the proxy.
		reverse_proxy mcp-grafana:8000 {
			flush_interval -1
			# mcp-grafana only accepts Host values on its --allowed-hosts list
			# (docker/mcp/docker-compose.yml). The public name is checked above;
			# send the internal one so that list never has to name the domain.
			header_up Host {upstream_hostport}
		}
	}
}

# Actual Budget MCP (docker/mcp-budget). LAN + tailnet only, like budget itself.
# The server enforces its own bearer token (--enable-bearer), so Caddy only
# proxies; flush_interval -1 keeps SSE events from being buffered.
budget-mcp.{$HOMELAB_DOMAIN} {
	reverse_proxy mcp-budget:3000 {
		flush_interval -1
	}
}

# Kali webtop — booted on-demand by Sablier, scaled to zero when idle.
# Selkies requires a secure context; this now gets a genuine certificate rather
# than Caddy's internal CA, so the browser no longer has to be told to trust it.
kali.{$HOMELAB_DOMAIN} {
	route {
		sablier http://sablier:10000 {
			group desktops
			session_duration 30m
			dynamic {
				display_name "Kali Desktop"
				theme hacker-terminal
			}
		}
		reverse_proxy kali-linux:3000
	}
}

# ── Health check ────────────────────────────────────────────────────────────
# The one site addressed by container name rather than by hostname, and it
# exists for blackbox-exporter alone.
#
# blackbox probes over the Docker network, so the URL it fetches is
# `http://caddy/...` and the Host header it sends is the literal string `caddy`.
# That matches none of the sites above — they are all `<name>.$HOMELAB_DOMAIN`
# or `*.home` — and Caddy answers an unmatched Host with 404. blackbox's
# `http_2xx` module counts anything that is not a 2xx as a failed probe, so the
# "Service endpoint unreachable" alert fired against a perfectly healthy Caddy,
# round the clock, from the day the probe was added.
#
# So give the probe a Host that Caddy actually serves. Answering here at all
# proves what the probe is for: the process is up, listening on :80, and routing
# requests. It is deliberately not a redirect and not a proxy — nothing about
# this endpoint should depend on a backend or a certificate, or the uptime check
# starts reporting on something other than Caddy.
#
# `http://` on purpose: `caddy` is a container name, no public CA will ever
# issue for it, and Caddy must not try. Reachable only from inside the Docker
# networks — a request from the LAN or tailnet arrives with a real hostname in
# the Host header and never lands here.
http://caddy {
	handle /health {
		respond "OK" 200
	}
	handle {
		respond 404
	}
}

# ── Legacy *.home names ─────────────────────────────────────────────────────
# Kept so existing bookmarks, shell aliases and the dev machines' MCP config
# keep working. They are declared `http://` on purpose: `.home` is not a real
# TLD, so no public CA will ever issue for it and Caddy must not try. Each one
# simply redirects to its real name.
#
# These depend on the AdGuard rewrites (*.home → 10.0.0.201). Once nothing uses
# them, delete this section and the rewrites; AdGuard itself stays for ad
# blocking and as the tailnet resolver.

http://stats.home {
	redir https://stats.{$HOMELAB_DOMAIN}{uri} permanent
}

http://chat.home {
	redir https://chat.{$HOMELAB_DOMAIN}{uri} permanent
}

http://apps.home {
	redir https://apps.{$HOMELAB_DOMAIN}{uri} permanent
}

http://dns.home {
	redir https://dns.{$HOMELAB_DOMAIN}{uri} permanent
}

http://alerts.home {
	redir https://alerts.{$HOMELAB_DOMAIN}{uri} permanent
}

http://mcp.home {
	redir https://mcp.{$HOMELAB_DOMAIN}{uri} permanent
}

http://kali.home {
	redir https://kali.{$HOMELAB_DOMAIN}{uri} permanent
}
