# --- Discord ---------------------------------------------------------------
# Bot token: https://discord.com/developers/applications -> your app -> Bot ->
# Reset Token. Treat it like a password; anyone holding it controls the bot.
DISCORD_TOKEN=changeme-discord-bot-token

# Right-click your server (with Developer Mode on) -> Copy Server ID.
DISCORD_GUILD_ID=000000000000000000

# The channel the digest posts into. Leave this alone for now: `--provision`
# creates #digest and prints the real ID to paste here. It is the one value you
# cannot fill in up front, so nothing before that step requires it.
DISCORD_DIGEST_CHANNEL_ID=000000000000000000

# Comma-separated Discord user IDs allowed to run commands (right-click your
# avatar -> Copy User ID). REQUIRED: without it, anyone who can see the bot
# could queue jobs onto your CPU.
DISCORD_ALLOWED_USER_IDS=000000000000000000

# --- Conversational channel (optional) --------------------------------------
# Channel where you can just TALK to the model — no slash command. Every message
# gets a reply, and the recent messages are used as context so you can go
# back and forth. Right-click #chat -> Copy Channel ID.
#
# Leave blank to disable. Enabling it makes the bot request the Message Content
# privileged intent (toggle it on: Developer Portal -> Bot -> Privileged Gateway
# Intents -> Message Content), because Discord otherwise delivers messages with
# an empty body and the bot cannot see what you typed. The intent is
# server-wide, so the bot narrows it in code: it only reads this one channel
# (and threads under it), only from users in the allowlist.
DISCORD_CHAT_CHANNEL_ID=

# How much conversation to feed back. Prompt evaluation is CPU-bound and roughly
# linear in tokens, so a longer memory means a slower reply every time; both
# caps apply, whichever bites first.
CHAT_HISTORY_TURNS=12
CHAT_HISTORY_CHARS=4000
CHAT_NUM_PREDICT=350

# Give the conversation live homelab readings. Before each reply the bot runs the
# same Prometheus/Loki queries the digest uses and injects one compact line of
# facts, so "how's the server doing?" gets a real answer instead of "I can't see
# your systems".
#
# Injected, not exposed as a tool the model can call: tool-calling is unreliable
# on a 3B (docs/design/tsd-ai-homelab-assistant.md), so the model never decides
# whether to look — it simply always has the numbers. Python measures, the model
# only reads them out.
#
# Costs ~50-60 tokens of prompt per turn. Set false to turn it off.
CHAT_LIVE_METRICS=true
# Seconds to reuse a reading before re-querying. The queries are cheap but a
# rapid back-and-forth would re-run six of them per message, and a homelab does
# not change meaningfully between two messages typed seconds apart.
CHAT_METRICS_TTL_S=60

# --- Schedule --------------------------------------------------------------
# IANA timezone for the digest schedule and timestamps.
TZ=America/New_York
# Local time to post the daily digest (HH:MM, 24h).
DIGEST_AT=07:30
# Set false to keep the slash commands but stop the scheduled post.
DIGEST_ENABLED=true

# --- Model -----------------------------------------------------------------
# Must match a tag built by docker/ai/load-models.sh.
OLLAMA_MODEL=llama3.2:3b

# --- Inference budget (see README -> "Why the caps") -----------------------
# Prompt evaluation is CPU-bound and scales with context length; keep this
# modest unless you like waiting.
OLLAMA_NUM_CTX=4096
ASK_NUM_PREDICT=400
SUMMARIZE_NUM_PREDICT=300
DIGEST_NUM_PREDICT=180
# Hard ceiling on one generation, seconds.
LLM_TIMEOUT_S=300
# Input longer than this is truncated before it reaches the model.
MAX_INPUT_CHARS=6000
# Jobs allowed to wait in line before new requests are rejected.
MAX_QUEUE=8

# Override the path to the declarative server layout. Defaults to the copy
# baked into the image (/srv/guild.yml), or the repo checkout when run locally.
# GUILD_FILE=/srv/guild.yml

# LOG_LEVEL=INFO
