# --- Discord ---------------------------------------------------------------
# Bot token: https://discord.com/developers/applications -> your app -> Bot ->
# Reset Token. Treat it like a password; anyone holding it controls the bot.
DISCORD_TOKEN=changeme-discord-bot-token

# Right-click your server (with Developer Mode on) -> Copy Server ID.
DISCORD_GUILD_ID=000000000000000000

# The channel the digest posts into. Leave this alone for now: `--provision`
# creates #digest and prints the real ID to paste here. It is the one value you
# cannot fill in up front, so nothing before that step requires it.
DISCORD_DIGEST_CHANNEL_ID=000000000000000000

# Comma-separated Discord user IDs allowed to run commands (right-click your
# avatar -> Copy User ID). REQUIRED: without it, anyone who can see the bot
# could queue jobs onto your CPU.
DISCORD_ALLOWED_USER_IDS=000000000000000000

# --- Conversational channel (optional) --------------------------------------
# Channel where you can just TALK to the model — no slash command. Every message
# gets a reply, and the recent messages are used as context so you can go
# back and forth. Right-click #chat -> Copy Channel ID.
#
# #chat is no longer in guild.yml (removed 2026-10-12; #ask covers it), so
# provisioning does not create it. To use this again, restore the channel in
# guild.yml from git history, run --provision --apply, then set the ID here.
#
# Leave blank to disable. Enabling it makes the bot request the Message Content
# privileged intent (toggle it on: Developer Portal -> Bot -> Privileged Gateway
# Intents -> Message Content), because Discord otherwise delivers messages with
# an empty body and the bot cannot see what you typed. The intent is
# server-wide, so the bot narrows it in code: it only reads this one channel
# (and threads under it), only from users in the allowlist.
DISCORD_CHAT_CHANNEL_ID=

# How much conversation to feed back. Prompt evaluation is CPU-bound and roughly
# linear in tokens, so a longer memory means a slower reply every time; both
# caps apply, whichever bites first.
CHAT_HISTORY_TURNS=12
CHAT_HISTORY_CHARS=4000
CHAT_NUM_PREDICT=350

# Reply randomness. Voice on a 3B is empirical — raise this if replies feel
# canned or open the same way every time; below ~0.5 it gets repetitive, above
# ~0.9 it drifts off the question.
CHAT_TEMPERATURE=0.6

# Give the conversation live homelab readings. Before each reply the bot runs the
# same Prometheus/Loki queries the digest uses and injects one compact line of
# facts, so "how's the server doing?" gets a real answer instead of "I can't see
# your systems".
#
# Injected, not exposed as a tool the model can call: tool-calling is unreliable
# on a 3B (docs/design/tsd-ai-homelab-assistant.md), so the model never decides
# whether to look — it simply always has the numbers. Python measures, the model
# only reads them out.
#
# Costs ~50-60 tokens of prompt per turn. Set false to turn it off.
CHAT_LIVE_METRICS=true
# Seconds to reuse a reading before re-querying. The queries are cheap but a
# rapid back-and-forth would re-run six of them per message, and a homelab does
# not change meaningfully between two messages typed seconds apart.
CHAT_METRICS_TTL_S=60

# --- Schedule --------------------------------------------------------------
# IANA timezone for the digest schedule and timestamps.
TZ=America/New_York
# Local time to post the daily digest (HH:MM, 24h).
DIGEST_AT=07:30
# Set false to keep the slash commands but stop the scheduled post.
DIGEST_ENABLED=true

# Where the bot records that a scheduled digest posted. heartbeat.sh reads it
# from the host and publishes homelab_digest_timestamp_seconds, and
# hl-digest-missing alerts in #alerts when it goes past 25h.
#
# You do not need to set this. The default matches the mount in
# docker-compose.yml, and `scripts/install-cron.sh` creates the host directory
# with the right owner (uid 10001 — the bot drops privileges). Override only if
# you moved the mount.
# DIGEST_STAMP_PATH=/state/last-digest

# --- Links in the digest ----------------------------------------------------
# Public Grafana base URL. The digest footer links to the dashboards that cover
# whatever it found — Triage always, plus Endpoints / Capacity / Logs when there
# is something on them worth opening.
#
# Must be the name that works from OUTSIDE this box, because these links are
# clicked on a phone: `http://grafana:3000` resolves only on the Docker network,
# and `stats.home` only through AdGuard. Use the same public name Grafana itself
# is configured with (GF_SERVER_ROOT_URL in docker/monitoring/docker-compose.yml).
#
# Leave blank to render the digest with no links at all.
GRAFANA_URL=https://stats.example.com

# --- Today: calendar and mail (optional) -------------------------------------
# Adds a "Today" section to the digest: today's remaining events, overlapping
# meetings, and new mail from the last 24h. Leave all three blank to turn it off.
# Setup, once (full steps in README.md → "Today: calendar and mail"):
#   1. Google Cloud Console: enable the Calendar and Gmail APIs, create an OAuth
#      client of type "Desktop app", and set the consent screen's publishing
#      status to "In production". Left in "Testing", Google expires the refresh
#      token after 7 days, and hl-google-stale will tell you so every week.
#   2. Paste the client ID and secret here.
#   3. docker compose run --rm assistant --google-auth   and paste its output below.
#
# Read-only by scope, which Google enforces: calendar.events.readonly, and
# gmail.metadata — headers and labels, never a message body.
#
# Privacy: senders, subjects and event titles are posted to #digest, so they
# are stored by Discord. They are never sent to the model. Set
# GOOGLE_SOURCES=calendar to leave mail out entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which sources to read: calendar, mail, or both (comma-separated).
GOOGLE_SOURCES=calendar,mail
# Calendars to read, comma-separated. "primary" is your own; others use the
# calendar ID from Google Calendar → Settings → Integrate calendar.
GOOGLE_CALENDAR_IDS=primary
# Gmail label IDs a message must carry ALL of to count. The default is unread
# mail in the Primary tab. Labels rather than a search, because the metadata
# scope does not allow searching.
GMAIL_LABELS=INBOX,UNREAD,CATEGORY_PERSONAL

# --- Home: Home Assistant (optional) ----------------------------------------
# Adds a "Home" line to Today: anything open, unlocked, leaking, low on battery,
# offline, or a thermostat that is off or too hot/cold, among the entities you
# list, with how long it has been that way. HA_CALENDARS merges HA calendars
# (iCloud via CalDAV) into the Calendar line. Leave all three blank to turn it
# off. Setup: docker/homeassistant/README.md.
#
# A long-lived token for a DEDICATED, NON-ADMIN Home Assistant user. Home
# Assistant has no read-only token: any token can also unlock and open. The
# digest only ever reads (app/home.py), but treat this value as a house key.
HA_TOKEN=
# Comma-separated entity IDs to watch (Settings → Entities in HA). Only these
# are read. A typo or a renamed device shows up as "not found", never silently.
# Example: cover.garage_door,lock.front_door,binary_sensor.back_door,binary_sensor.basement_leak,climate.thermostat
HA_ENTITIES=
# Comma-separated calendar.* entities whose events join Google's on the
# Calendar line (iCloud, added to HA through the CalDAV integration). Optional;
# needs HA_TOKEN. A calendar HA does not know fails the read, never silently.
# Example: calendar.home,calendar.work,calendar.sonarr
HA_CALENDARS=
# Of those, calendars whose events are shown but never flagged as overlapping
# anything: a TV schedule is not a double-booking. Example: calendar.sonarr
HA_FREE_CALENDARS=
# Only if Home Assistant is not the homeassistant container on this box. It
# runs on host networking, so the default goes through the host.
# HA_URL=http://host.docker.internal:8123

# --- #ask: the concierge (optional) -----------------------------------------
# Claude, running in docker/concierge/: reads freely, and proposes calendar
# events, Gmail drafts and scenes that run only on your ✅. All blank = off. Both
# channel IDs come from `--provision --apply`, which creates #ask and #memory.
# Setting #ask requires the Message Content intent (same toggle as #chat).
DISCORD_ASK_CHANNEL_ID=
DISCORD_MEMORY_CHANNEL_ID=
# Optional: #activity, a bot-only log of every approved action that changed
# something, each linking to the #ask thread it came from. Blank = off.
DISCORD_ACTIVITY_CHANNEL_ID=
# Optional: #follow-ups, where each approved follow-up waits as one bot message
# until it is due (delete the message to cancel). Blank = not saved.
DISCORD_FOLLOWUPS_CHANNEL_ID=
# Same value as CONCIERGE_TOKEN in docker/concierge/.env (openssl rand -hex 32).
CONCIERGE_TOKEN=
# The morning brief, a section of each scheduled digest: Claude reads the last day of
# mail and the week's calendar (read-only) and posts what needs you. Opt-in,
# because it sends mail to Anthropic every morning unasked. Needs #ask above.
BRIEF_ENABLED=false
# The evening review, a thread in #ask at REVIEW_AT: Claude reads the day's #ask
# threads and #activity (never your mail) and says what is still open, proposing
# memories and follow-ups. Skipped, at no cost, on a day with nothing to read.
REVIEW_ENABLED=false
REVIEW_AT=21:00
# Home Assistant entities whose last 24h the review summarizes (needs HA_TOKEN),
# e.g. sensor.tesla_battery_level,binary_sensor.tesla_charging,sensor.litter_robot_status
REVIEW_HA_ENTITIES=

# --- Model -----------------------------------------------------------------
# Must match a tag built by docker/ai/load-models.sh.
OLLAMA_MODEL=llama3.2:3b

# --- Inference budget (see README -> "Why the caps") -----------------------
# Prompt evaluation is CPU-bound and scales with context length; keep this
# modest unless you like waiting.
OLLAMA_NUM_CTX=4096
# How long Ollama keeps the model in RAM after a request. Its own default is 5
# minutes, which makes the first message after any pause pay a full reload from
# disk before generating a single token — in a chat channel that is exactly the
# message you are waiting on. "-1" never unloads (~2.5 GB held), "0" unloads
# immediately. Sent on every request, so it keeps the model warm for Open WebUI
# too.
OLLAMA_KEEP_ALIVE=30m
ASK_NUM_PREDICT=400
SUMMARIZE_NUM_PREDICT=300
DIGEST_NUM_PREDICT=180
# Hard ceiling on one generation, seconds.
LLM_TIMEOUT_S=300
# Input longer than this is truncated before it reaches the model.
MAX_INPUT_CHARS=6000
# Jobs allowed to wait in line before new requests are rejected.
MAX_QUEUE=8

# Override the path to the declarative server layout. Defaults to the copy
# baked into the image (/srv/guild.yml), or the repo checkout when run locally.
# GUILD_FILE=/srv/guild.yml

# LOG_LEVEL=INFO
