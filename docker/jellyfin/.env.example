# The group that owns the iGPU's render node INSIDE CT 100, so Jellyfin can use
# it for VA-API transcoding. After the GPU passthrough (README → "1. GPU"):
#   stat -c %g /dev/dri/renderD128
# Required: the stack refuses to start without it.
RENDER_GID=

# IANA timezone, for scheduled tasks (scans at 03:30) and log timestamps.
TZ=America/New_York
