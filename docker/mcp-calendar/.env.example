# Home Assistant long-lived access token. Make it on a dedicated, non-admin HA
# user (Settings -> People -> add a user, then log in as it -> Profile ->
# Security -> Long-lived access tokens), not your own login. The code only ever
# GETs /api/calendars/<entity> for the IDs below.
HA_TOKEN=

# Where Home Assistant answers. It runs on host networking, so the default is
# right unless you moved it.
HA_URL=http://host.docker.internal:8123

# The calendars Claude may read: calendar.* IDs, comma-separated. Same IDs as
# HA_CALENDARS in docker/assistant/.env and docker/concierge/.env.
HA_CALENDARS=calendar.appointments,calendar.events,calendar.work

# Dates are interpreted in this zone ("today", all-day events).
TZ=America/New_York
