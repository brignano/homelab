# Home Assistant long-lived access token. Make it on a dedicated, non-admin HA
# user (Settings -> People -> add a user, then log in as it -> Profile ->
# Security -> Long-lived access tokens), not your own login. The code only ever
# GETs /api/calendars/<entity> for the IDs below.
HA_TOKEN=

# Where Home Assistant answers. It runs on host networking, so the default is
# right unless you moved it.
HA_URL=http://host.docker.internal:8123

# The calendars Claude may read: calendar.* IDs, comma-separated. Same IDs as
# HA_CALENDARS in docker/assistant/.env and docker/concierge/.env.
HA_CALENDARS=calendar.appointments,calendar.events,calendar.work,calendar.sonarr

# Dates are interpreted in this zone ("today", all-day events).
TZ=America/New_York

# --- Optional: Claude in the cloud, via Cloudflare Tunnel + Access -------------
# Leave all three blank to keep the server tailnet-only (port 8001 stays closed).
# See README.md, "Reaching it from Claude in the cloud". None of these is a secret.
#
# Your Zero Trust team domain (Zero Trust -> Settings -> Team name and domain).
ACCESS_TEAM_DOMAIN=
# The Access application's Application Audience (AUD) tag (Access application ->
# Overview / Basic information).
ACCESS_AUD=
# Emails allowed through, comma-separated. Same as the Access policy; checked
# again here so a loosened policy alone can't open the calendar.
ACCESS_EMAILS=
