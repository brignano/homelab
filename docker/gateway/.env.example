# docker/gateway/.env — the secure gateway's settings. See docs/runbook-gateway.md.
#
# This repo is public, so hostnames, AUD tags and allowlists live here on the
# box and nowhere else. CI fails if this example file ever holds a real value:
# every line below must stay empty.

# Your Zero Trust team domain: <team>.cloudflareaccess.com
# (Zero Trust -> Settings -> Custom pages / Team domain).
ACCESS_TEAM_DOMAIN=

# --- route: selftest (throwaway; remove once #362's checks pass) --------------
# A random first-level name under the zone, e.g. 6 random letters and digits.
GW_HOST_SELFTEST=
# The Access application's AUD tag (Access -> Applications -> the app -> Overview).
GW_AUD_SELFTEST=
# Who may use the route: emails for people, token:<Client ID> for service tokens.
GW_ALLOW_SELFTEST=
