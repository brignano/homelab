# Base domain, same value as docker/proxy/.env. The dashboard needs it twice:
# once so Homepage will accept requests for home.<domain> (it rejects unknown
# Host headers outright), and once to build the tile links.
HOMELAB_DOMAIN=home.example.com

# Healthchecks project id — the UUID in the dashboard URL:
#   https://healthchecks.io/projects/<THIS>/checks/
# Optional. It is kept out of the committed config because this repo is public
# and the id is scoped to the account; it is not a credential (healthchecks.io
# requires login) but it does not belong in a public file either. The ping URL
# IS a secret and lives in docker/monitoring/.env — do not put it here.
HEALTHCHECKS_PROJECT_ID=

# Coordinates for the header's weather (Open-Meteo, no account or key). Two or
# three decimal places is plenty: that is roughly a neighbourhood, not a house.
# Optional; unset, the widget offers to use the browser's location instead.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
