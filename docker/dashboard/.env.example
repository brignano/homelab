# Read by the proxy (docker/proxy/docker-compose.yml, env_file) and served to
# the home page as /api/home.json. Nothing here is a secret, and all of it is
# optional: unset, the page hides the weather and the Healthchecks link.

# Healthchecks project id — the UUID in the dashboard URL:
#   https://healthchecks.io/projects/<THIS>/checks/
# Kept out of the committed config because this repo is public and the id is
# scoped to the account. The ping URL IS a secret and lives in
# docker/monitoring/.env — do not put it here.
HEALTHCHECKS_PROJECT_ID=

# Coordinates for the hero's weather (Open-Meteo, no account or key). Two or
# three decimal places is plenty: that is roughly a neighbourhood, not a house.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
