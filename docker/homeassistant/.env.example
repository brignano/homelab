# Home Assistant needs no secrets of its own here: users, integrations and
# their credentials are created in its UI and live in the homeassistant_config
# volume.
#
# The token the digest reads with belongs to the ASSISTANT stack, not this one:
# HA_TOKEN in docker/assistant/.env (see docker/homeassistant/README.md).

# IANA timezone. Match docker/assistant/.env so "open for 2h" in the digest and
# HA's own history agree.
TZ=America/New_York
