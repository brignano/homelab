# Your Apple ID (the email you sign in to iCloud with). Required. The password
# is never stored: it is typed once at `./scripts/photos-sync.sh --auth`, and
# again each time Apple ends the session (roughly every two months).
ICLOUD_USERNAME=

# How much the nightly sync may download in one calendar month, in GB, counted
# on the container's network interface. 0 means no limit.
#
# Some Xfinity plans cap at about 1.2 TB a month, and the first sync is about
# 1.5 TB, so the default spreads it over about three months and leaves room for
# the rest of the household. When a run reaches the budget it stops cleanly and
# resumes on the 1st. Set 0 after the switch to fiber (docs/runbook-isp-switch.md).
PHOTOS_MONTHLY_BUDGET_GB=500

# The hour (0-23, local time) at which a run still going is stopped, so a long
# backfill never eats the household's daytime bandwidth. The next night picks
# up where it stopped: icloudpd skips what is already on disk and resumes a
# half-downloaded file.
PHOTOS_STOP_HOUR=7

# IANA timezone, for log timestamps.
TZ=America/New_York
