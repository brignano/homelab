# Long-lived access token of the `matterbridge` user (an admin) in Home
# Assistant (README → "Home Assistant user"). Required: the stack refuses to
# start without it. Like every HA token, it can operate any entity, so it lives
# here and nowhere else.
HA_TOKEN=

# The Home Assistant label that opts an entity in to Alexa. Case as shown in HA.
HA_LABEL=Alexa

# CT 100's LAN interface. Matter is advertised on it only, so the Echo is never
# handed a Docker bridge address it cannot reach. Check with `ip -br addr`.
MDNS_INTERFACE=eth0

# IANA timezone, for log timestamps.
TZ=America/New_York
